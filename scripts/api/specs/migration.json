    "/api/migration/{jobId}/items": {
      "get": {
        "operationId": "items",
        "parameters": [
          {
            "in": "path",
            "name": "jobId",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "description": "항목 상태 필터. 비우면 전부",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "PENDING",
                "RUNNING",
                "RETRY_WAIT",
                "COMPLETED",
                "DEAD_LETTER"
              ]
            }
          },
          {
            "description": "이관 단계 필터. 비우면 전부",
            "in": "query",
            "name": "stage",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "EXTRACT",
                "NORMALIZE",
                "MEDIA_COPY",
                "RESOLVE",
                "VERIFY",
                "DONE"
              ]
            }
          },
          {
            "description": "0부터 세는 페이지 번호",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0
