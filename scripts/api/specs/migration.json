          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformError"
                }
              }
            },
            "description": "권한 서비스(org) 불능"
          }
        },
        "summary": "이관 작업을 시작한다",
        "tags": [
